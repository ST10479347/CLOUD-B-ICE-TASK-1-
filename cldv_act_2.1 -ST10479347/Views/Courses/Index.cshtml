@model List<cldv_act_2._1.Models.Course>


@{
    ViewData["Title"] = "Courses";
}

<h2>Courses</h2>
<a asp-action="Create" class="btn btn-primary">Add New Course</a>

<table class="table">
    <thead>
        <tr>
            <th>Code</th>
            <th>Name</th>
            <th>Instructor</th>
            <th>Capacity</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var course in Model)
        {
            <tr>
                <td>@course.CourseCode</td>
                <td>@course.CourseName</td>
                <td>@course.Instructor</td>
                <td>@course.Capacity</td>
                <td>
                    <a asp-action="Details" asp-route-id="@course.RowKey">Details</a> |
                    <a asp-action="Edit" asp-route-id="@course.RowKey">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@course.RowKey">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
